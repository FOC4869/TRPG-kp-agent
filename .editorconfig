root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# Binary assets are not text and must not be reformatted on save
[*.{xlsx,png,jpg,jpeg,webp,gif,ico,pdf,zip,woff,woff2,mp3,mp4}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
