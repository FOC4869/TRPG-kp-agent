  "opening": [
    {
      "id": "opening",
      "kind": "keeper",
      "speaker": "守秘人",
      "text": "1920 年代，普罗维登斯。作家乔什·文斯考特邀请你来到正在修缮的老宅。他在地窖发现了一条被封堵的旧隧道，想请你一起调查。"
    },
    {
      "id": "josh-opening",
      "kind": "npc",
      "speaker": "乔什·文斯考特",
      "text": "地窖下面似乎藏着一条真正的旧隧道。我还没进去太远。你愿意陪我看看吗？我们现在出发，还是明天再来？"
    }
  ],
  "scenes": {
    "winscott_house": {
      "name": "文斯考特宅",
      "background": "bg_winscott_house",
      "public": "1920 年代，普罗维登斯。作家乔什·文斯考特邀请你来到正在修缮的老宅。他在地窖发现了一条被封堵的旧隧道，想请你一起调查。",
      "keeper": "乔什只知道自己发现的地道和家族传说，不知道地下生物与真正来历。",
      "region": "普罗维登斯 · 学院山",
      "clauses": []
    },
    "house_cellar": {
      "name": "宅邸地窖",
      "background": "bg_house_cellar",
      "public": "潮湿的地窖里，拆开的砖墙露出一道可供人通过的隧道口。墙边有手电筒、绳索和撬棍，可以带走。",
      "keeper": "装备必须明确领取；时间线已经固定。",
      "region": "普罗维登斯 · 学院山",
      "clauses": [
        {
          "when": {
            "npc:josh:stage": "missing"
          },
          "text": "乔什不在这里，足迹通向地下；他目前仍失踪。"
        }
      ]
    },
    "old_tunnel": {
      "name": "旧隧道",
      "background": "bg_old_tunnel",
      "public": "低矮的旧隧道朝地下延伸。前方散落着古旧的人类遗骸与破损衣物，深处通向一间石造大厅。",
      "keeper": "遗骸和衣物显而易见。烟头需要侦查，只在次日路线与乔什有关；失败不阻碍前进。",
      "region": "普罗维登斯 · 学院山",
      "clauses": []
    },
    "entrance_hall": {
      "name": "地下入口厅",
      "background": "bg_entrance_hall",
      "public": "石厅的雕刻呈现出异样的爬行生物。通往深处的路横着一片松动碎石；侧面另有一条通向壁画厅的路。",
      "keeper": "绳索可免检定通过碎石。普通跨越DEX失败1D3HP。先到历史厅可选，进入牢笼区需通过碎石。",
      "region": "普罗维登斯 · 学院山",
      "clauses": []
    },
    "history_hall": {
      "name": "历史厅",
      "background": "bg_history_hall",
      "public": "墙面覆盖着描绘远古地球与爬行种族的巨大壁画，繁复的图像令人不安。你可以研究，也可以返回入口厅。",
      "keeper": "EDU成功解读后SAN0/1D3一次。无需解读也能继续。",
      "region": "普罗维登斯 · 学院山",
      "clauses": []
    },
    "cage_area": {
      "name": "地下牢笼区",
      "background": "bg_cage_area",
      "public": "阴冷的石室内排列着锈蚀铁笼。",
      "keeper": "蛇人首次出现SAN0/1D6。通过威胁前不能接近铁笼。同行线乔什始终在身边，绝不出现第二个乔什。此为简化终场，无魔法/战斗回合。",
      "region": "普罗维登斯 · 学院山",
      "clauses": [
        {
          "when": {
            "flag:threat_passed": true
          },
          "text": "你已经通过蛇形生物的威胁，可以接近铁笼，不需要再次突破。"
        },
        {
          "when": {
            "not": {
              "flag:threat_passed": true
            }
          },
          "text": "一个尚未完全清醒的蛇形身影阻挡着通往铁笼的路。"
        },
        {
          "when": {
            "flag:cage_open": true
          },
          "text": "铁笼已经打开。"
        },
        {
          "when": {
            "not": {
              "flag:cage_open": true
            }
          },
          "text": "铁笼尚未打开。"
        },
        {
          "when": {
            "flag:timeline": "together"
          },
          "text": "乔什始终与你同行，没有被囚禁，无需营救。"
        },
        {
          "when": {
            "all": [
              {
                "flag:timeline": "missing"
              },
              {
                "npc:josh:stage": "following"
              }
            ]
          },
          "text": "你已经救出乔什，他现在跟随你，需要你照顾。"
        },
        {
          "when": {
            "all": [
              {
                "flag:timeline": "missing"
              },
              {
                "npc:josh:stage": "missing"
              }
            ]
          },
          "text": "失踪的乔什就在铁笼中，尚未被你帮助离开。"
        },
        {
          "when": {},
          "text": "退回入口厅的来路始终畅通，撤离不需要再次通过威胁。"
        }
      ]
    }
  },
