# 复制为项目根目录的 .env，然后在本机填写。
# 程序自动读 .env；终端已设置的环境变量优先，不会被 .env 覆盖。
# 修改 .env 后，退出并重新启动程序才会生效。
# 不要把真实 API key 发到聊天、群里或提交 GitHub。
# 默认仍是离线；双击 run_deepseek.command 或加 --mode deepseek 才使用 DeepSeek。
KP_MODEL_MODE=demo
KP_RETRIEVAL_MODE=keyword

# DeepSeek 官方 API；key 留空，自己在 .env 填写。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Responses API 可选 none / low / high / max；none 关闭思考，先减少等待。
DEEPSEEK_REASONING_EFFORT=none
# 以下输出上限也包含思考 token。
DEEPSEEK_PLAN_MAX_TOKENS=1024
DEEPSEEK_NARRATION_MAX_TOKENS=2048

# 保留 OpenAI 方式；只用 DeepSeek 时不需要填这些。
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
# OPENAI_BASE_URL=自定义兼容 Responses 的地址，仅在确有需要时设置
